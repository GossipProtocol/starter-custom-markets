# ── Mode ─────────────────────────────────────────────────────────────────
# With nothing set, the web app runs in DEMO mode: a mock wallet, markets in
# localStorage, bets simulated with the program's maths. Fully usable, zero
# secrets. Copy this file to apps/web/.env.local and fill the groups below
# one at a time to go live. The mobile app has its own apps/mobile/.env.example.

# ── Wallet / auth (Privy) ────────────────────────────────────────────────
# Client: setting the app id switches the app from demo to live and turns on
# email login with an embedded Solana wallet.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Server: lets the money routes verify the caller's access token and read
# their wallet from Privy. Never exposed to the client.
PRIVY_APP_SECRET=

# ── Database (Postgres, server-only) ─────────────────────────────────────
# A cache of the chain plus titles and labels. Any Postgres works; Neon and
# Supabase both do. `npm run db:push` in apps/web creates the tables.
# DIRECT_URL is the non-pooled connection Prisma uses for migrations; set it
# to the same value as DATABASE_URL if your provider has no pooler.
DATABASE_URL=
DIRECT_URL=

# ── Chain ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Public RPC the browser uses for Privy's wallet flows.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Private RPC the server and crons use. Falls back to the public one.
SOLANA_RPC_URL=
# From `anchor keys list` after build and deploy. The placeholder below is
# Anchor's default and will not exist on any cluster.
NEXT_PUBLIC_MARKETS_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS
# Devnet USDC by default. Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ── Program admins ───────────────────────────────────────────────────────
# The audited program keeps its admin list as constants (ADMIN_WALLETS in
# programs/cue-solana/src/config.rs). List the same wallets here, comma
# separated, so the server can refuse a create or cancel before building a
# transaction the program would reject. The Privy wallet you create markets
# with and the ADMIN_SECRET_KEY below both belong in config.rs and here.
MARKET_ADMIN_WALLETS=

# ── Server keys (server-only) ────────────────────────────────────────────
# Pays for the cron's resolve_market calls. Resolution is permissionless on
# chain, so this key has no power a bettor does not.
# JSON array, comma list or base58.
RESOLVER_SECRET_KEY=
# Optional. One of the program's ADMIN_WALLETS. The cron signs withdraw_fees
# with it after the 24 hour cooldown. Unset, fees stay in the vaults until an
# admin withdraws by hand.
ADMIN_SECRET_KEY=
# Optional. When set, the server pays the transaction fee for bettors. The
# position rent is still paid by the user, because the audited place_bet
# has `payer = user`.
SPONSOR_SECRET_KEY=
# Shared secret the cron scheduler sends as `Authorization: Bearer`.
CRON_SECRET=

# The course fee recipient is not an env var on purpose. It lives in
# apps/web/lib/course-fee.ts (and, as PROTOCOL_TREASURY, in
# programs/cue-solana/src/config.rs) and is a default.
