# ── Privy (Expo SDK) ─────────────────────────────────────────────────────
# Same app as the web app. The client id comes from the dashboard's
# "Clients" tab for the mobile app.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# ── API ──────────────────────────────────────────────────────────────────
# The web app, which builds and submits every transaction.
EXPO_PUBLIC_API_URL=http://localhost:3000
